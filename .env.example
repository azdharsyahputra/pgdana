# Server Port
PORT=8080

# Security Keys
API_KEY=my-secret-api-key
WEBHOOK_SECRET=my-webhook-secret-token

# Merchant Profile
MERCHANT_NAME=Toko Digital Saya

# Template QRIS Statis Kamu (BCA / GoPay / LinkAja / ShopeePay / Mandiri)
# Kosongkan untuk menggunakan template simulasi default saat testing
QRIS_STATIC=

# Anti Double-Claim Mode (true = otomatis tambah 1-999 ke nominal agar tiap transaksi 100% unik)
USE_UNIQUE_CODE=true

# Masa berlaku invoice pembayaran dalam menit
INVOICE_EXPIRY_MINUTES=15

# Lokasi penyimpanan database invoice (JSON persistent)
DATA_FILE=./data/invoices.json

# Webhook Callback ke Bot Telegram / Web Toko Online kamu saat lunas (Opsional)
CLIENT_WEBHOOK_URL=
